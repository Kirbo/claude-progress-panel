#!/usr/bin/env bash
set -euo pipefail
#
# 1. Biome over the staged files: fix what it can, re-stage the fixed files, refuse the commit when
#    anything is left (scripts/lint-staged.mjs — a partly staged file is never re-staged).
# 2. Seal every sealed file (.sealed.json: the audit reports) edited since it was last sealed, stage
#    the .age blob with the commit, and refuse a staged plaintext. Public-key encryption: needs no
#    key. The blob is built from the WORKING TREE file, not the index (deliberate: a half-sealed
#    report is not a useful artifact).

cd "$(git rev-parse --show-toplevel)"
# node, biome and age come from mise.toml; use mise when it is installed (hooks run without its
# shims on PATH).
run() { if command -v mise >/dev/null 2>&1; then mise exec -- "$@"; else "$@"; fi; }
run node scripts/lint-staged.mjs
run node scripts/seal.mjs hook-pre-commit
